From bc98d15da6bf3d59a37373e9d9bb3bb68be3873c Mon Sep 17 00:00:00 2001
From: Ian <219239532+markd3ng@users.noreply.github.com>
Date: Tue, 8 Sep 2026 09:04:18 +0800
Subject: [PATCH] fix(security): use Web Crypto for generated secrets

Context:
Generated paste names and management passwords used Math.random, which is not suitable for security-sensitive values.

Expected behavior:
genRandStr uses the Worker Web Crypto API and produces values from the existing safe alphabet.

Acceptance criteria:
- No Math.random for paste names or management passwords.
- Add focused generator coverage.

Constraints:
- Keep the existing alphabet and API unchanged.
- Do not rewrite authentication or introduce dependencies.

Validation:
- git diff --check passed.
- No Math.random remains in the affected generation paths.
- CI will run repository tests, coverage, and Feishu validation.

Docs:
- N/A.

Refs:
- Closes #77
- Issue: https://github.com/Skyline-Gazer/pastebin-worker/issues/77
- Scope freeze: no additional feature scope authorized.
---
 worker/common.ts           | 15 ++++++++++++---
 worker/test/common.spec.ts | 13 ++++++++++++-
 2 files changed, 24 insertions(+), 4 deletions(-)

diff --git a/worker/common.ts b/worker/common.ts
index 68e497dbcf7e89ab11e48e3dbd379a87756b1f39..01e8cf1a1274f201a1fd71f1d93494eb6817cc64 100644
--- a/worker/common.ts
+++ b/worker/common.ts
@@ -38,12 +38,21 @@ export function dateToUnix(date: Date): number {
 }
 
 export function genRandStr(len: number) {
-  // TODO: switch to Web Crypto random generator
   let str = ""
   const numOfRand = CHAR_GEN.length
-  for (let i = 0; i < len; i++) {
-    str += CHAR_GEN.charAt(Math.floor(Math.random() * numOfRand))
+  const maxUnbiasedByte = 256 - (256 % numOfRand)
+  const bytes = new Uint8Array(128)
+
+  while (str.length < len) {
+    crypto.getRandomValues(bytes)
+    for (const byte of bytes) {
+      if (byte < maxUnbiasedByte) {
+        str += CHAR_GEN.charAt(byte % numOfRand)
+        if (str.length === len) break
+      }
+    }
   }
+
   return str
 }
 
diff --git a/worker/test/common.spec.ts b/worker/test/common.spec.ts
index c4bd7c638f4564b1dca8e3d46b8a37c77434e192..c19b5009e77ce42b4c4db77584559cb59d070db8 100644
--- a/worker/test/common.spec.ts
+++ b/worker/test/common.spec.ts
@@ -1,6 +1,8 @@
 import { describe, it, expect } from "vitest"
 
-import { timingSafeEqual } from "../common.js"
+import { genRandStr, timingSafeEqual } from "../common.js"
+
+const CHAR_GEN = "ABCDEFGHJKMNPQRSTWXYZabcdefhijkmnprstwxyz2345678"
 
 describe("timingSafeEqual", () => {
   it("returns true for equal strings", () => {
@@ -38,3 +40,12 @@ describe("timingSafeEqual", () => {
     expect(timingSafeEqual("日本語", "日本誤")).toBe(false)
   })
 })
+
+describe("genRandStr", () => {
+  it("generates the requested number of characters from the safe alphabet", () => {
+    const value = genRandStr(256)
+
+    expect(value).toHaveLength(256)
+    expect([...value].every((character) => CHAR_GEN.includes(character))).toBe(true)
+  })
+})


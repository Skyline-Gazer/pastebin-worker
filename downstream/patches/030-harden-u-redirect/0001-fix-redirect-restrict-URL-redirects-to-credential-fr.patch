index f67620edb9a2ae377f12e4d8e369343c73d590c6..06ad604df3fe7e6714cdbda0d47a510390da29ca 100644
--- a/shared/verify.ts
+++ b/shared/verify.ts
@@ -7,6 +7,19 @@ export function isLegalUrl(url: string): boolean {
   return URL.canParse(url)
 }
 
+export function isLegalRedirectUrl(url: string): boolean {
+  if (!URL.canParse(url)) {
+    return false
+  }
+
+  const parsedUrl = new URL(url)
+  return (
+    (parsedUrl.protocol === "http:" || parsedUrl.protocol === "https:") &&
+    parsedUrl.username === "" &&
+    parsedUrl.password === ""
+  )
+}

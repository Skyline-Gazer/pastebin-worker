+      namedR2Object = claimedR2Object
     } else {
       pasteName = genRandStr(isPrivate ? PRIVATE_PASTE_NAME_LEN : PASTE_NAME_LEN)
     }
@@ -276,7 +276,7 @@ export async function handlePostOrPut(
         highlightLanguage,
         contentLength: r2Object?.size || contentLength,

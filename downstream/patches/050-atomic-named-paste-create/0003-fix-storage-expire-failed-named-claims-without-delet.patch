diff --git a/worker/test/writeConcurrency.spec.ts b/worker/test/writeConcurrency.spec.ts
index 5e6d81d721a0bdc787969f93aea7e1c46f2ca2e8..81ca76dc5976194207cca5cab89f1f3b4543a11c 100644
